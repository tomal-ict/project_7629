# ============================================================
# ABC AI System Limited — Universal Web Router (cPanel / Apache / LiteSpeed)
# ============================================================

<IfModule mod_dir.c>
    DirectoryIndex index.html index.php
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Pass Authorization Header to PHP-FPM / FastCGI (Required on cPanel/aaPanel)
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Prevent directory indexing
    <IfModule mod_negotiation.c>
        Options -Indexes
    </IfModule>

    # Strip PHP & Server signatures
    <IfModule mod_headers.c>
        Header unset X-Powered-By
        Header always unset X-Powered-By
    </IfModule>

    # Protect internal system and environment files
    RewriteRule ^(\.git|\.env|composer\.|package\.|phpunit\.xml) - [F,L]
    RewriteRule ^backend/(\.env|storage/logs/.*|artisan|composer\.) - [F,L]

    # 1. Route backend API calls directly to Laravel front controller
    RewriteRule ^api/(.*)$ backend/public/index.php [QSA,L]

    # 2. Serve physical static files directly if present
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # 3. Fallback to backend/public if asset exists there
    RewriteCond %{DOCUMENT_ROOT}/backend/public/$1 -f
    RewriteRule ^(assets|css|js|images)/(.*)$ backend/public/$1/$2 [L]

    # 4. SPA Fallback for all client-side routes
    RewriteRule ^ index.html [L]
</IfModule>
